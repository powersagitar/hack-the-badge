{
  "name": "hack-the-badge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based emulator for the Hack the North 2026 hacker badge (ESP32-C3), running its real firmware.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build ../emulator-wasm --target web --out-dir ../frontend/src/cpu/wasm-pkg",
    "bench:wasm": "bun bench/bun-bench.ts",
    "bench:safari": "bun bench/safari-bench.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
