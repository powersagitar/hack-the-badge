{
  "name": "hack-the-badge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based emulator for the Hack the North 2026 hacker badge (ESP32-C3), running its real firmware.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build ../emulator-wasm --target web --out-dir ../frontend/src/cpu/wasm-pkg",
    "bench:wasm": "bun bench/bun-bench.ts",
    "bench:safari": "bun bench/safari-bench.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "matter-js": "0.20.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/matter-js": "0.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
