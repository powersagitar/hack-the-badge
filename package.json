{
  "name": "hack-the-badge-root",
  "private": true,
  "description": "Convenience proxy: forwards scripts to the frontend/ module so they can be run from the repo root.",
  "scripts": {
    "install:frontend": "bun install --cwd frontend",
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "preview": "bun run --cwd frontend preview",
    "test": "bun run --cwd frontend test",
    "typecheck": "bun run --cwd frontend typecheck",
    "build:wasm": "bun run --cwd frontend build:wasm"
  }
}
